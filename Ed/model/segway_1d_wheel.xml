<?xml version="1.0"?>
<!--
  segway_1d_wheel.xml
  Based on Ozzy's segway_2.xml with two changes:
    1. Reaction wheel body + motor REMOVED  → pure 1D forward/backward
    2. Euler integrator  → ~4x faster than default RK4

  Physics identical to Arthur's model.
  State layout (freejoint + 1 hinge):
    qpos = [x, y, z, qw, qx, qy, qz, wheel_angle]
    qvel = [vx, vy, vz, wx, wy, wz, wheel_speed]
  Useful channels:
    x        = qpos[0]
    theta    = from qpos[3:7] via fast quaternion formula
    xdot     = qvel[0]
    thetadot = qvel[4]   (wy in world frame = pitch rate)
  Single actuator:
    ctrl[0] = wheel torque,  ctrlrange [-5, 5] Nm
-->
<mujoco model="segway_1d_wheel">

  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"/>

  <visual>
    <headlight diffuse="1 1 1" ambient="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
  </visual>

  <default>
    <default class="wheel">
      <geom type="cylinder" friction="2 0.005 0.0001"/>
    </default>
  </default>


  <worldbody>
    <!-- Plain light grey floor, no checkerboard -->
    <geom name="ground" type="plane" size="5 5 .05"
          pos="0 0 0" rgba="0.85 0.85 0.85 1"
          contype="1" conaffinity="1"/>
    <!-- Bright overhead light -->
    <light name="top" pos="0 0 8" dir="0 0 -1"
           diffuse="1 1 1" specular="0.4 0.4 0.4" directional="true"/>
    <!-- Side fill light to remove harsh shadows -->
    <light name="fill" pos="4 -4 5" dir="-1 1 -1"
           diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" directional="true"/>

    <!-- Goal marker at x=2 m -->
    <geom name="goal_line" type="box"
          pos="2.0 0 0.005" size="0.01 0.4 0.005"
          rgba="0.1 0.85 0.1 0.7" contype="0" conaffinity="0"/>

    <body name="segway" pos="0 0 0.075">
      <freejoint name="root"/>

      <!-- Chassis (identical to Ozzy's) -->
      <geom name="chassis" type="box"
            size="0.05 0.155 0.12" pos="0 0 0.12"
            mass="4.75" rgba="0.2 0.4 0.7 1"/>

      <!-- Ground wheel (identical to Ozzy's) -->
      <body name="ground_wheel" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <joint name="joint_ground_wheel" type="hinge" axis="0 0 1" damping="0.05"/>
        <geom name="wheel_geom" class="wheel"
              size="0.075 0.05" mass="0.32" rgba="0.05 0.05 0.05 1"/>
      </body>

      <!-- Reaction wheel REMOVED -->

    </body>
  </worldbody>

  <!-- Single wheel motor only (reaction wheel motor REMOVED) -->
  <actuator>
    <motor name="wheel_motor" joint="joint_ground_wheel"
           gear="1" ctrlrange="-5.0 5.0"/>
  </actuator>

</mujoco>